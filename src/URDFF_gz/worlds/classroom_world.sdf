<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="classroom_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.95 0.95 1.0 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.3 -0.9</direction>
    </light>

    <!-- ═══════════ FLOOR ═══════════ -->
    <model name="classroom_floor"><static>true</static><link name="link">
      <collision name="c"><geometry><plane><normal>0 0 1</normal></plane></geometry></collision>
      <visual name="v"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.9 0.9 0.87 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
      </visual></link></model>

    <!-- ═══════════ WALLS ═══════════ -->
    <model name="front_wall"><pose>5 0 1.5 0 0 0</pose><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>0.15 10 3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.15 10 3</size></box></geometry>
        <material><ambient>0.92 0.92 0.88 1</ambient><diffuse>0.95 0.95 0.92 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
      </visual></link></model>

    <model name="back_wall"><pose>-5 0 1.5 0 0 0</pose><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>0.15 10 3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.15 10 3</size></box></geometry>
        <material><ambient>0.92 0.92 0.88 1</ambient><diffuse>0.95 0.95 0.92 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
      </visual></link></model>

    <model name="left_wall"><pose>0 5 1.5 0 0 0</pose><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>10 0.15 3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>10 0.15 3</size></box></geometry>
        <material><ambient>0.92 0.92 0.88 1</ambient><diffuse>0.95 0.95 0.92 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
      </visual></link></model>

    <model name="right_wall"><pose>0 -5 1.5 0 0 0</pose><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>10 0.15 3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>10 0.15 3</size></box></geometry>
        <material><ambient>0.92 0.92 0.88 1</ambient><diffuse>0.95 0.95 0.92 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
      </visual></link></model>

    <!-- ═══════════ WHITEBOARD ═══════════ -->
    <model name="whiteboard"><pose>4.85 0 1.2 0 0 0</pose><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>0.05 3.5 1.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.05 3.5 1.5</size></box></geometry>
        <material><ambient>0.98 0.98 0.98 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse><specular>0.5 0.5 0.5 1</specular></material>
